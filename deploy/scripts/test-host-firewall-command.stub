#!/bin/sh
command_name=__COMMAND__
printf '%s %s\n' "$command_name" "$*" >> "${STUB_COMMAND_LOG:?}"
case "$command_name:$*" in
  'id:-u') printf '%s\n' 0 ;;
  'ss:-lntH') printf '%s\n' 'LISTEN 0 4096 0.0.0.0:22' ;;
  'ufw:show added')
    printf '%s\n' 'Added user rules:'
    [ -z "${STUB_UFW_RULE:-}" ] || printf '%s\n' "$STUB_UFW_RULE"
    ;;
  'iptables:-w -N FLOW_TASK_INGRESS'|'iptables:-w -C DOCKER-USER -j FLOW_TASK_INGRESS') exit 1 ;;
esac
