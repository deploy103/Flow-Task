generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  USER
  SYSTEM_ADMIN
}

enum MembershipRole {
  MEMBER
  MENTOR
  ORG_ADMIN
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
}

enum AnnouncementAudience {
  ALL_MEMBERS
  SELECTED_MEMBERS
}

enum AssignmentAudience {
  ALL_MEMBERS
  SELECTED_MEMBERS
}

enum AssignmentFieldType {
  TEXT
  FILE
  LINK
}

enum AssignmentItemType {
  EXTERNAL_CHALLENGE
  INTERNAL_CTF
  QUIZ
}

enum ExternalChallengeSource {
  DREAMHACK
  OTHER
}

enum ChallengeCategory {
  WEB
  SYSTEM
  REVERSING
  FORENSICS
  CRYPTOGRAPHY
  NETWORK
  PROGRAMMING
  OTHER
}

enum InternalChallengeMode {
  STATIC_FILE
  SHARED_SERVER
  PERSONAL_INSTANCE
}

enum ChallengeInstanceStatus {
  STARTING
  RUNNING
  STOPPED
  EXPIRED
  FAILED
}

enum OrganizationIntegrationKind {
  DISCORD_WEBHOOK
  GENERIC_WEBHOOK
  EMAIL_RELAY
}

enum NotificationChannel {
  EMAIL
  WEB_PUSH
  DISCORD
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum QuizIntegrityEventType {
  TAB_HIDDEN
  WINDOW_BLUR
  COPY
  PASTE
  IP_CHANGED
}

enum ChallengeConnectionProtocol {
  HTTPS
  HTTP
  TCP
  SSH
}

enum QuizQuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  SHORT_TEXT
  LONG_TEXT
  FLAG
  FILE
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  GRADED
}

enum QuizResultRelease {
  IMMEDIATE
  AFTER_DEADLINE
  AFTER_GRADING
  HIDDEN
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  LATE
  REVIEWING
  APPROVED
  RESUBMIT_REQUIRED
}

enum SubmissionUploadStatus {
  PENDING
  CONSUMED
  FAILED
  CLEANED
}

enum SubmissionReviewDecision {
  REVIEWING
  APPROVED
  RESUBMIT_REQUIRED
}

enum NotificationType {
  ANNOUNCEMENT_CREATED
  ASSIGNMENT_CREATED
  DEADLINE_APPROACHING
  MISSING_SUBMISSION
  RESUBMIT_REQUIRED
  SUBMISSION_APPROVED
  QUESTION_CREATED
  QUESTION_ANSWERED
  QUESTION_ASSIGNED
  ANSWER_ACCEPTED
}

enum CalendarEventType {
  CLASS
  MEETING
  EVENT
}

enum QuestionBoardType {
  PUBLIC_QNA
  MENTOR_QNA
  PRIVATE_MENTOR
}

enum QuestionCategory {
  WEB
  SYSTEM
  REVERSING
  FORENSICS
  CRYPTOGRAPHY
  NETWORK
  PROGRAMMING
  ASSIGNMENT
  OTHER
}

enum QuestionStatus {
  WAITING
  IN_PROGRESS
  NEEDS_INFO
  RESOLVED
  CLOSED
}

enum MentorRelationType {
  PRIMARY
  SECONDARY
}

model User {
  id                      String                    @id @db.Uuid
  email                   String                    @unique @db.VarChar(320)
  name                    String                    @db.VarChar(50)
  studentNumber           String?                   @map("student_number") @db.VarChar(30)
  birthDate               DateTime?                 @map("birth_date") @db.Date
  privacyConsentAt        DateTime?                 @map("privacy_consent_at") @db.Timestamptz(6)
  privacyConsentVersion   String?                   @map("privacy_consent_version") @db.VarChar(20)
  systemRole              SystemRole                @default(USER) @map("system_role")
  createdAt               DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  emailVerifiedAt         DateTime?                 @map("email_verified_at") @db.Timestamptz(6)
  memberships             OrganizationMember[]
  organizations           Organization[]            @relation("OrganizationCreator")
  invitations             OrganizationInvite[]      @relation("InvitationCreator")
  auditLogs               AuditLog[]
  announcements           Announcement[]            @relation("AnnouncementAuthor")
  announcementTargets     AnnouncementTarget[]
  announcementReads       AnnouncementRead[]
  assignments             Assignment[]              @relation("AssignmentCreator")
  assignmentTargets       AssignmentTarget[]
  submissions             Submission[]
  submissionUploads       SubmissionUpload[]
  submissionReviews       SubmissionReview[]        @relation("SubmissionReviewer")
  notifications           Notification[]
  calendarEvents          CalendarEvent[]           @relation("CalendarEventCreator")
  questions               Question[]                @relation("QuestionAuthor")
  assignedQuestions       Question[]                @relation("QuestionAssignedMentor")
  questionAnswers         QuestionAnswer[]
  mentorRelations         MentorRelation[]          @relation("MentorRelationMentor")
  menteeRelations         MentorRelation[]          @relation("MentorRelationMentee")
  challengeSubmissions    ChallengeSubmission[]
  quizQuestions           QuizQuestion[]            @relation("QuizQuestionCreator")
  quizAttempts            QuizAttempt[]
  gradedQuizAnswers       QuizAnswer[]              @relation("QuizAnswerGrader")
  notificationPreference  NotificationPreference?
  webPushSubscriptions    WebPushSubscription[]
  challengeInstances      ChallengeInstance[]
  createdIntegrations     OrganizationIntegration[] @relation("IntegrationCreator")
  credential              UserCredential?
  sessions                AuthSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@map("users")
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, consumedAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, consumedAt])
  @@map("password_reset_tokens")
}

model UserCredential {
  userId       String   @id @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
  @@map("auth_sessions")
}

model AuthRateLimit {
  keyHash         String   @map("key_hash") @db.Char(64)
  action          String   @db.VarChar(20)
  attempts        Int      @default(0)
  windowStartedAt DateTime @default(now()) @map("window_started_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([keyHash, action])
  @@index([updatedAt])
  @@map("auth_rate_limits")
}

model Organization {
  id              String                    @id @default(uuid()) @db.Uuid
  name            String                    @db.VarChar(80)
  description     String?                   @db.VarChar(500)
  logoStoragePath String?                   @unique @map("logo_storage_path") @db.VarChar(500)
  logoMimeType    String?                   @map("logo_mime_type") @db.VarChar(50)
  logoUpdatedAt   DateTime?                 @map("logo_updated_at") @db.Timestamptz(6)
  createdById     String                    @map("created_by_id") @db.Uuid
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt      DateTime?                 @map("archived_at") @db.Timestamptz(6)
  createdBy       User                      @relation("OrganizationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members         OrganizationMember[]
  invites         OrganizationInvite[]
  auditLogs       AuditLog[]
  announcements   Announcement[]
  assignments     Assignment[]
  notifications   Notification[]
  calendarEvents  CalendarEvent[]
  questions       Question[]
  mentorRelations MentorRelation[]
  quizQuestions   QuizQuestion[]
  integrations    OrganizationIntegration[]

  @@index([createdById])
  @@map("organizations")
}

model OrganizationMember {
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           MembershipRole   @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([organizationId, userId])
  @@index([userId, status])
  @@map("organization_members")
}

model OrganizationInvite {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  codeHash       String         @unique @map("code_hash") @db.Char(64)
  role           MembershipRole @default(MEMBER)
  maxUses        Int?           @map("max_uses")
  usedCount      Int            @default(0) @map("used_count")
  expiresAt      DateTime       @map("expires_at") @db.Timestamptz(6)
  createdById    String         @map("created_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt      DateTime?      @map("revoked_at") @db.Timestamptz(6)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy      User           @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, expiresAt])
  @@map("organization_invites")
}

model AuditLog {
  id             BigInt        @id @default(autoincrement())
  actorId        String        @map("actor_id") @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  action         String        @db.VarChar(80)
  targetType     String        @map("target_type") @db.VarChar(50)
  targetId       String?       @map("target_id") @db.VarChar(100)
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  actor          User          @relation(fields: [actorId], references: [id], onDelete: Restrict)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model Announcement {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  authorId       String               @map("author_id") @db.Uuid
  title          String               @db.VarChar(100)
  content        String               @db.Text
  priority       AnnouncementPriority @default(NORMAL)
  audience       AnnouncementAudience @default(ALL_MEMBERS)
  publishedAt    DateTime             @default(now()) @map("published_at") @db.Timestamptz(6)
  expiresAt      DateTime?            @map("expires_at") @db.Timestamptz(6)
  archivedAt     DateTime?            @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  author         User                 @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  targets        AnnouncementTarget[]
  reads          AnnouncementRead[]

  @@index([organizationId, publishedAt])
  @@map("announcements")
}

model AnnouncementTarget {
  announcementId String       @map("announcement_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([announcementId, userId])
  @@index([userId])
  @@map("announcement_targets")
}

model AnnouncementRead {
  announcementId String       @map("announcement_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  confirmedAt    DateTime     @default(now()) @map("confirmed_at") @db.Timestamptz(6)
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([announcementId, userId])
  @@index([userId, confirmedAt])
  @@map("announcement_reads")
}

model Assignment {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  createdById       String             @map("created_by_id") @db.Uuid
  title             String             @db.VarChar(100)
  description       String             @db.Text
  audience          AssignmentAudience @default(ALL_MEMBERS)
  opensAt           DateTime           @map("opens_at") @db.Timestamptz(6)
  deadline          DateTime           @db.Timestamptz(6)
  allowLate         Boolean            @default(false) @map("allow_late")
  archivedAt        DateTime?          @map("archived_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy         User               @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  targets           AssignmentTarget[]
  fields            AssignmentField[]
  submissions       Submission[]
  submissionUploads SubmissionUpload[]
  questions         Question[]
  items             AssignmentItem[]

  @@index([organizationId, opensAt, deadline])
  @@map("assignments")
}

model AssignmentTarget {
  assignmentId String     @map("assignment_id") @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([assignmentId, userId])
  @@index([userId])
  @@map("assignment_targets")
}

model AssignmentField {
  id           String              @id @default(uuid()) @db.Uuid
  assignmentId String              @map("assignment_id") @db.Uuid
  type         AssignmentFieldType
  label        String              @db.VarChar(80)
  required     Boolean             @default(true)
  position     Int
  assignment   Assignment          @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  answers      SubmissionAnswer[]
  files        SubmissionFile[]
  uploads      SubmissionUpload[]

  @@unique([assignmentId, position])
  @@unique([assignmentId, type])
  @@map("assignment_fields")
}

model AssignmentItem {
  id                   String                @id @default(uuid()) @db.Uuid
  assignmentId         String                @map("assignment_id") @db.Uuid
  type                 AssignmentItemType
  position             Int
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignment           Assignment            @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  externalChallenge    ExternalChallenge?
  internalChallenge    InternalChallenge?
  quiz                 Quiz?
  challengeGrading     ChallengeGrading?
  challengeSubmissions ChallengeSubmission[]

  @@unique([assignmentId, position])
  @@index([assignmentId, type])
  @@map("assignment_items")
}

model ExternalChallenge {
  assignmentItemId String                  @id @map("assignment_item_id") @db.Uuid
  source           ExternalChallengeSource
  platform         String                  @db.VarChar(80)
  title            String                  @db.VarChar(160)
  description      String                  @db.Text
  problemUrl       String                  @map("problem_url") @db.VarChar(2048)
  category         ChallengeCategory
  difficulty       String                  @db.VarChar(40)
  points           Int
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignmentItem   AssignmentItem          @relation(fields: [assignmentItemId], references: [id], onDelete: Cascade)

  @@index([source, category])
  @@map("external_challenges")
}

model InternalChallenge {
  assignmentItemId        String                       @id @map("assignment_item_id") @db.Uuid
  title                   String                       @db.VarChar(160)
  description             String                       @db.Text
  category                ChallengeCategory
  difficulty              String                       @db.VarChar(40)
  points                  Int
  mode                    InternalChallengeMode
  protocol                ChallengeConnectionProtocol?
  host                    String?                      @db.VarChar(253)
  port                    Int?
  instanceTemplateRef     String?                      @map("instance_template_ref") @db.VarChar(160)
  instanceCpuMilli        Int?                         @map("instance_cpu_milli")
  instanceMemoryMb        Int?                         @map("instance_memory_mb")
  instanceLifetimeMinutes Int?                         @map("instance_lifetime_minutes")
  createdAt               DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignmentItem          AssignmentItem               @relation(fields: [assignmentItemId], references: [id], onDelete: Cascade)
  hints                   ChallengeHint[]
  resources               ChallengeResource[]
  instances               ChallengeInstance[]

  @@index([mode, category])
  @@map("internal_challenges")
}

model ChallengeHint {
  id                String            @id @default(uuid()) @db.Uuid
  assignmentItemId  String            @map("assignment_item_id") @db.Uuid
  content           String            @db.VarChar(1000)
  position          Int
  internalChallenge InternalChallenge @relation(fields: [assignmentItemId], references: [assignmentItemId], onDelete: Cascade)

  @@unique([assignmentItemId, position])
  @@map("challenge_hints")
}

model ChallengeResource {
  id                String            @id @default(uuid()) @db.Uuid
  assignmentItemId  String            @map("assignment_item_id") @db.Uuid
  storagePath       String            @unique @map("storage_path") @db.VarChar(500)
  originalFilename  String            @map("original_filename") @db.VarChar(255)
  mimeType          String            @map("mime_type") @db.VarChar(150)
  sizeBytes         BigInt            @map("size_bytes")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  internalChallenge InternalChallenge @relation(fields: [assignmentItemId], references: [assignmentItemId], onDelete: Restrict)

  @@index([assignmentItemId])
  @@map("challenge_resources")
}

model ChallengeGrading {
  assignmentItemId       String         @id @map("assignment_item_id") @db.Uuid
  flagDigest             String?        @map("flag_digest") @db.Char(64)
  flagFormat             String?        @map("flag_format") @db.VarChar(160)
  caseSensitive          Boolean        @default(true) @map("case_sensitive")
  trimWhitespace         Boolean        @default(true) @map("trim_whitespace")
  maxAttempts            Int?           @map("max_attempts")
  penaltyPerWrongAttempt Int            @default(0) @map("penalty_per_wrong_attempt")
  requireWriteup         Boolean        @default(false) @map("require_writeup")
  requireWriteupUrl      Boolean        @default(false) @map("require_writeup_url")
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignmentItem         AssignmentItem @relation(fields: [assignmentItemId], references: [id], onDelete: Cascade)

  @@map("challenge_grading")
}

model ChallengeSubmission {
  id            String             @id @default(uuid()) @db.Uuid
  itemId        String             @map("assignment_item_id") @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  attemptsCount Int                @default(0) @map("attempts_count")
  completedAt   DateTime?          @map("completed_at") @db.Timestamptz(6)
  score         Int                @default(0)
  writeup       String?            @db.Text
  writeupUrl    String?            @map("writeup_url") @db.VarChar(2048)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  item          AssignmentItem     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  user          User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  attempts      ChallengeAttempt[] @relation("ChallengeSubmissionAttempts")

  @@unique([itemId, userId])
  @@index([itemId, completedAt])
  @@index([userId, updatedAt])
  @@map("challenge_submissions")
}

model ChallengeAttempt {
  id                String              @id @default(uuid()) @db.Uuid
  itemId            String              @map("assignment_item_id") @db.Uuid
  userId            String              @map("user_id") @db.Uuid
  attemptNumber     Int                 @map("attempt_number")
  isCorrect         Boolean             @map("is_correct")
  scoreAfterAttempt Int                 @map("score_after_attempt")
  submittedAt       DateTime            @default(now()) @map("submitted_at") @db.Timestamptz(6)
  submission        ChallengeSubmission @relation("ChallengeSubmissionAttempts", fields: [itemId, userId], references: [itemId, userId], onDelete: Restrict)

  @@unique([itemId, userId, attemptNumber])
  @@index([itemId, submittedAt])
  @@index([userId, submittedAt])
  @@map("challenge_attempts")
}

model Quiz {
  assignmentItemId String                  @id @map("assignment_item_id") @db.Uuid
  title            String                  @db.VarChar(160)
  description      String                  @db.Text
  timeLimitMinutes Int?                    @map("time_limit_minutes")
  attemptLimit     Int                     @default(1) @map("attempt_limit")
  passingScore     Int?                    @map("passing_score")
  shuffleQuestions Boolean                 @default(false) @map("shuffle_questions")
  shuffleChoices   Boolean                 @default(false) @map("shuffle_choices")
  resultRelease    QuizResultRelease       @default(AFTER_GRADING) @map("result_release")
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignmentItem   AssignmentItem          @relation(fields: [assignmentItemId], references: [id], onDelete: Cascade)
  questions        QuizQuestionPlacement[]
  attempts         QuizAttempt[]

  @@map("quizzes")
}

model QuizQuestion {
  id              String                  @id @default(uuid()) @db.Uuid
  organizationId  String                  @map("organization_id") @db.Uuid
  createdById     String                  @map("created_by_id") @db.Uuid
  type            QuizQuestionType
  prompt          String                  @db.Text
  description     String?                 @db.Text
  points          Int
  required        Boolean                 @default(true)
  difficulty      String                  @db.VarChar(40)
  tags            String[]                @default([])
  explanation     String?                 @db.Text
  caseSensitive   Boolean                 @default(false) @map("case_sensitive")
