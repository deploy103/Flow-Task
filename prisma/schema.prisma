generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  USER
  SYSTEM_ADMIN
}

enum MembershipRole {
  MEMBER
  MENTOR
  ORG_ADMIN
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
}

enum AnnouncementAudience {
  ALL_MEMBERS
  SELECTED_MEMBERS
}

enum AssignmentAudience {
  ALL_MEMBERS
  SELECTED_MEMBERS
}

enum AssignmentFieldType {
  TEXT
  FILE
  LINK
}

enum AssignmentItemType {
  EXTERNAL_CHALLENGE
}

enum ExternalChallengeSource {
  DREAMHACK
  OTHER
}

enum ChallengeCategory {
  WEB
  SYSTEM
  REVERSING
  FORENSICS
  CRYPTOGRAPHY
  NETWORK
  PROGRAMMING
  OTHER
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  LATE
  REVIEWING
  APPROVED
  RESUBMIT_REQUIRED
}

enum SubmissionUploadStatus {
  PENDING
  CONSUMED
  FAILED
  CLEANED
}

enum SubmissionReviewDecision {
  REVIEWING
  APPROVED
  RESUBMIT_REQUIRED
}

enum NotificationType {
  ANNOUNCEMENT_CREATED
  ASSIGNMENT_CREATED
  DEADLINE_APPROACHING
  MISSING_SUBMISSION
  RESUBMIT_REQUIRED
  SUBMISSION_APPROVED
  QUESTION_CREATED
  QUESTION_ANSWERED
  QUESTION_ASSIGNED
  ANSWER_ACCEPTED
}

enum CalendarEventType {
  CLASS
  MEETING
  EVENT
}

enum QuestionBoardType {
  PUBLIC_QNA
  MENTOR_QNA
  PRIVATE_MENTOR
}

enum QuestionCategory {
  WEB
  SYSTEM
  REVERSING
  FORENSICS
  CRYPTOGRAPHY
  NETWORK
  PROGRAMMING
  ASSIGNMENT
  OTHER
}

enum QuestionStatus {
  WAITING
  IN_PROGRESS
  NEEDS_INFO
  RESOLVED
  CLOSED
}

enum MentorRelationType {
  PRIMARY
  SECONDARY
}

model User {
  id                   String                @id @db.Uuid
  email                String                @unique @db.VarChar(320)
  name                 String                @db.VarChar(50)
  studentNumber        String?               @map("student_number") @db.VarChar(30)
  systemRole           SystemRole            @default(USER) @map("system_role")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships          OrganizationMember[]
  organizations        Organization[]        @relation("OrganizationCreator")
  invitations          OrganizationInvite[]  @relation("InvitationCreator")
  auditLogs            AuditLog[]
  announcements        Announcement[]        @relation("AnnouncementAuthor")
  announcementTargets  AnnouncementTarget[]
  announcementReads    AnnouncementRead[]
  assignments          Assignment[]          @relation("AssignmentCreator")
  assignmentTargets    AssignmentTarget[]
  submissions          Submission[]
  submissionUploads    SubmissionUpload[]
  submissionReviews    SubmissionReview[]    @relation("SubmissionReviewer")
  notifications        Notification[]
  calendarEvents       CalendarEvent[]       @relation("CalendarEventCreator")
  questions            Question[]            @relation("QuestionAuthor")
  assignedQuestions    Question[]            @relation("QuestionAssignedMentor")
  questionAnswers      QuestionAnswer[]
  mentorRelations      MentorRelation[]      @relation("MentorRelationMentor")
  menteeRelations      MentorRelation[]      @relation("MentorRelationMentee")
  challengeSubmissions ChallengeSubmission[]

  @@map("users")
}

model Organization {
  id              String               @id @default(uuid()) @db.Uuid
  name            String               @db.VarChar(80)
  description     String?              @db.VarChar(500)
  createdById     String               @map("created_by_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt      DateTime?            @map("archived_at") @db.Timestamptz(6)
  createdBy       User                 @relation("OrganizationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members         OrganizationMember[]
  invites         OrganizationInvite[]
  auditLogs       AuditLog[]
  announcements   Announcement[]
  assignments     Assignment[]
  notifications   Notification[]
  calendarEvents  CalendarEvent[]
  questions       Question[]
  mentorRelations MentorRelation[]

  @@index([createdById])
  @@map("organizations")
}

model OrganizationMember {
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           MembershipRole   @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([organizationId, userId])
  @@index([userId, status])
  @@map("organization_members")
}

model OrganizationInvite {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  codeHash       String         @unique @map("code_hash") @db.Char(64)
  role           MembershipRole @default(MEMBER)
  maxUses        Int?           @map("max_uses")
  usedCount      Int            @default(0) @map("used_count")
  expiresAt      DateTime       @map("expires_at") @db.Timestamptz(6)
  createdById    String         @map("created_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt      DateTime?      @map("revoked_at") @db.Timestamptz(6)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy      User           @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, expiresAt])
  @@map("organization_invites")
}

model AuditLog {
  id             BigInt        @id @default(autoincrement())
  actorId        String        @map("actor_id") @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  action         String        @db.VarChar(80)
  targetType     String        @map("target_type") @db.VarChar(50)
  targetId       String?       @map("target_id") @db.VarChar(100)
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  actor          User          @relation(fields: [actorId], references: [id], onDelete: Restrict)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model Announcement {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  authorId       String               @map("author_id") @db.Uuid
  title          String               @db.VarChar(100)
  content        String               @db.Text
  priority       AnnouncementPriority @default(NORMAL)
  audience       AnnouncementAudience @default(ALL_MEMBERS)
  publishedAt    DateTime             @default(now()) @map("published_at") @db.Timestamptz(6)
  expiresAt      DateTime?            @map("expires_at") @db.Timestamptz(6)
  archivedAt     DateTime?            @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  author         User                 @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  targets        AnnouncementTarget[]
  reads          AnnouncementRead[]

  @@index([organizationId, publishedAt])
  @@map("announcements")
}

model AnnouncementTarget {
  announcementId String       @map("announcement_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([announcementId, userId])
  @@index([userId])
  @@map("announcement_targets")
}

model AnnouncementRead {
  announcementId String       @map("announcement_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  confirmedAt    DateTime     @default(now()) @map("confirmed_at") @db.Timestamptz(6)
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([announcementId, userId])
  @@index([userId, confirmedAt])
  @@map("announcement_reads")
}

model Assignment {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  createdById       String             @map("created_by_id") @db.Uuid
  title             String             @db.VarChar(100)
  description       String             @db.Text
  audience          AssignmentAudience @default(ALL_MEMBERS)
  opensAt           DateTime           @map("opens_at") @db.Timestamptz(6)
  deadline          DateTime           @db.Timestamptz(6)
  allowLate         Boolean            @default(false) @map("allow_late")
  archivedAt        DateTime?          @map("archived_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy         User               @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  targets           AssignmentTarget[]
  fields            AssignmentField[]
  submissions       Submission[]
  submissionUploads SubmissionUpload[]
  questions         Question[]
  items             AssignmentItem[]

  @@index([organizationId, opensAt, deadline])
  @@map("assignments")
}

model AssignmentTarget {
  assignmentId String     @map("assignment_id") @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([assignmentId, userId])
  @@index([userId])
  @@map("assignment_targets")
}

model AssignmentField {
  id           String              @id @default(uuid()) @db.Uuid
  assignmentId String              @map("assignment_id") @db.Uuid
  type         AssignmentFieldType
  label        String              @db.VarChar(80)
  required     Boolean             @default(true)
  position     Int
  assignment   Assignment          @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  answers      SubmissionAnswer[]
  files        SubmissionFile[]
  uploads      SubmissionUpload[]

  @@unique([assignmentId, position])
  @@unique([assignmentId, type])
  @@map("assignment_fields")
}

model AssignmentItem {
  id                   String                @id @default(uuid()) @db.Uuid
  assignmentId         String                @map("assignment_id") @db.Uuid
  type                 AssignmentItemType
  position             Int
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignment           Assignment            @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  externalChallenge    ExternalChallenge?
  challengeGrading     ChallengeGrading?
  challengeSubmissions ChallengeSubmission[]

  @@unique([assignmentId, position])
  @@index([assignmentId, type])
  @@map("assignment_items")
}

model ExternalChallenge {
  assignmentItemId String                  @id @map("assignment_item_id") @db.Uuid
  source           ExternalChallengeSource
  platform         String                  @db.VarChar(80)
  title            String                  @db.VarChar(160)
  description      String                  @db.Text
  problemUrl       String                  @map("problem_url") @db.VarChar(2048)
  category         ChallengeCategory
  difficulty       String                  @db.VarChar(40)
  points           Int
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignmentItem   AssignmentItem          @relation(fields: [assignmentItemId], references: [id], onDelete: Cascade)

  @@index([source, category])
  @@map("external_challenges")
}

model ChallengeGrading {
  assignmentItemId       String         @id @map("assignment_item_id") @db.Uuid
  flagDigest             String?        @map("flag_digest") @db.Char(64)
  flagFormat             String?        @map("flag_format") @db.VarChar(160)
  caseSensitive          Boolean        @default(true) @map("case_sensitive")
  trimWhitespace         Boolean        @default(true) @map("trim_whitespace")
  maxAttempts            Int?           @map("max_attempts")
  penaltyPerWrongAttempt Int            @default(0) @map("penalty_per_wrong_attempt")
  requireWriteup         Boolean        @default(false) @map("require_writeup")
  requireWriteupUrl      Boolean        @default(false) @map("require_writeup_url")
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignmentItem         AssignmentItem @relation(fields: [assignmentItemId], references: [id], onDelete: Cascade)

  @@map("challenge_grading")
}

model ChallengeSubmission {
  id            String             @id @default(uuid()) @db.Uuid
  itemId        String             @map("assignment_item_id") @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  attemptsCount Int                @default(0) @map("attempts_count")
  completedAt   DateTime?          @map("completed_at") @db.Timestamptz(6)
  score         Int                @default(0)
  writeup       String?            @db.Text
  writeupUrl    String?            @map("writeup_url") @db.VarChar(2048)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  item          AssignmentItem     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  user          User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  attempts      ChallengeAttempt[] @relation("ChallengeSubmissionAttempts")

  @@unique([itemId, userId])
  @@index([itemId, completedAt])
  @@index([userId, updatedAt])
  @@map("challenge_submissions")
}

model ChallengeAttempt {
  id                String              @id @default(uuid()) @db.Uuid
  itemId            String              @map("assignment_item_id") @db.Uuid
  userId            String              @map("user_id") @db.Uuid
  attemptNumber     Int                 @map("attempt_number")
  isCorrect         Boolean             @map("is_correct")
  scoreAfterAttempt Int                 @map("score_after_attempt")
  submittedAt       DateTime            @default(now()) @map("submitted_at") @db.Timestamptz(6)
  submission        ChallengeSubmission @relation("ChallengeSubmissionAttempts", fields: [itemId, userId], references: [itemId, userId], onDelete: Restrict)

  @@unique([itemId, userId, attemptNumber])
  @@index([itemId, submittedAt])
  @@index([userId, submittedAt])
  @@map("challenge_attempts")
}

model Submission {
  id            String              @id @default(uuid()) @db.Uuid
  assignmentId  String              @map("assignment_id") @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  status        SubmissionStatus    @default(DRAFT)
  latestVersion Int                 @default(0) @map("latest_version")
  submittedAt   DateTime?           @map("submitted_at") @db.Timestamptz(6)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignment    Assignment          @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  user          User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  versions      SubmissionVersion[]
  reviews       SubmissionReview[]

  @@unique([assignmentId, userId])
  @@index([assignmentId, status])
  @@index([userId, updatedAt])
  @@map("submissions")
}

model SubmissionVersion {
  id           String             @id @default(uuid()) @db.Uuid
  submissionId String             @map("submission_id") @db.Uuid
  version      Int
  status       SubmissionStatus
  savedAt      DateTime           @default(now()) @map("saved_at") @db.Timestamptz(6)
  submittedAt  DateTime?          @map("submitted_at") @db.Timestamptz(6)
  submission   Submission         @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  answers      SubmissionAnswer[]
  files        SubmissionFile[]
  reviews      SubmissionReview[]

  @@unique([submissionId, version])
  @@unique([submissionId, id])
  @@index([submissionId, savedAt])
  @@map("submission_versions")
}

model SubmissionAnswer {
  id        String            @id @default(uuid()) @db.Uuid
  versionId String            @map("version_id") @db.Uuid
  fieldId   String            @map("field_id") @db.Uuid
  value     String            @db.Text
  version   SubmissionVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  field     AssignmentField   @relation(fields: [fieldId], references: [id], onDelete: Restrict)

  @@unique([versionId, fieldId])
  @@index([fieldId])
  @@map("submission_answers")
}

model SubmissionFile {
  id               String            @id @default(uuid()) @db.Uuid
  versionId        String            @map("version_id") @db.Uuid
  fieldId          String            @map("field_id") @db.Uuid
  storagePath      String            @map("storage_path") @db.VarChar(500)
  originalFilename String            @map("original_filename") @db.VarChar(255)
  mimeType         String            @map("mime_type") @db.VarChar(100)
  sizeBytes        BigInt            @map("size_bytes")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  version          SubmissionVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  field            AssignmentField   @relation(fields: [fieldId], references: [id], onDelete: Restrict)

  @@index([versionId, fieldId])
  @@index([fieldId])
  @@index([storagePath])
  @@map("submission_files")
}

model SubmissionUpload {
  id                   String                 @id @default(uuid()) @db.Uuid
  assignmentId         String                 @map("assignment_id") @db.Uuid
  fieldId              String                 @map("field_id") @db.Uuid
  userId               String                 @map("user_id") @db.Uuid
  storagePath          String                 @unique @map("storage_path") @db.VarChar(500)
  originalFilename     String                 @map("original_filename") @db.VarChar(255)
  mimeType             String                 @map("mime_type") @db.VarChar(100)
  sizeBytes            BigInt                 @map("size_bytes")
  reservedBytes        BigInt                 @map("reserved_bytes")
  status               SubmissionUploadStatus @default(PENDING)
  expiresAt            DateTime               @map("expires_at") @db.Timestamptz(6)
  signedTokenExpiresAt DateTime               @map("signed_token_expires_at") @db.Timestamptz(6)
  cleanupAfter         DateTime               @map("cleanup_after") @db.Timestamptz(6)
  consumedAt           DateTime?              @map("consumed_at") @db.Timestamptz(6)
  cleanedAt            DateTime?              @map("cleaned_at") @db.Timestamptz(6)
  cleanupAttempts      Int                    @default(0) @map("cleanup_attempts")
  lastCleanupAttemptAt DateTime?              @map("last_cleanup_attempt_at") @db.Timestamptz(6)
  cleanupError         String?                @map("cleanup_error") @db.VarChar(80)
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  assignment           Assignment             @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  field                AssignmentField        @relation(fields: [fieldId], references: [id], onDelete: Restrict)
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([userId, status, expiresAt])
  @@index([status, cleanupAfter])
  @@index([assignmentId, fieldId, userId])
  @@map("submission_uploads")
}

model SubmissionReview {
  id           String                   @id @default(uuid()) @db.Uuid
  submissionId String                   @map("submission_id") @db.Uuid
  versionId    String                   @map("version_id") @db.Uuid
  reviewerId   String                   @map("reviewer_id") @db.Uuid
  decision     SubmissionReviewDecision
  feedback     String?                  @db.Text
  score        Int?
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  submission   Submission               @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  version      SubmissionVersion        @relation(fields: [submissionId, versionId], references: [submissionId, id], onDelete: Restrict)
  reviewer     User                     @relation("SubmissionReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([submissionId, createdAt])
  @@index([versionId, createdAt])
  @@index([reviewerId, createdAt])
  @@map("submission_reviews")
}

model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  organizationId String?          @map("organization_id") @db.Uuid
  type           NotificationType
  title          String           @db.VarChar(120)
  body           String           @db.VarChar(500)
  href           String           @db.VarChar(500)
  dedupeKey      String           @map("dedupe_key") @db.VarChar(180)
  readAt         DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@index([organizationId, createdAt])
  @@map("notifications")
}

model CalendarEvent {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  createdById    String            @map("created_by_id") @db.Uuid
  type           CalendarEventType
  title          String            @db.VarChar(100)
  description    String?           @db.VarChar(1000)
  startsAt       DateTime          @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime          @map("ends_at") @db.Timestamptz(6)
  archivedAt     DateTime?         @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy      User              @relation("CalendarEventCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, startsAt, endsAt])
  @@index([createdById, createdAt])
  @@map("calendar_events")
}

model MentorRelation {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  mentorId       String             @map("mentor_id") @db.Uuid
  menteeId       String             @map("mentee_id") @db.Uuid
  type           MentorRelationType @default(SECONDARY)
  startedAt      DateTime           @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt        DateTime?          @map("ended_at") @db.Timestamptz(6)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  mentor         User               @relation("MentorRelationMentor", fields: [mentorId], references: [id], onDelete: Restrict)
  mentee         User               @relation("MentorRelationMentee", fields: [menteeId], references: [id], onDelete: Restrict)

  @@unique([organizationId, mentorId, menteeId])
  @@index([organizationId, menteeId, type, endedAt])
  @@index([organizationId, mentorId, endedAt])
  @@map("mentor_relations")
}

model Question {
  id                  String               @id @default(uuid()) @db.Uuid
  organizationId      String               @map("organization_id") @db.Uuid
  authorId            String               @map("author_id") @db.Uuid
  assignedMentorId    String?              @map("assigned_mentor_id") @db.Uuid
  relatedAssignmentId String?              @map("related_assignment_id") @db.Uuid
  boardType           QuestionBoardType    @map("board_type")
  category            QuestionCategory
  status              QuestionStatus       @default(WAITING)
  title               String               @db.VarChar(120)
  content             String               @db.Text
  attempted           String?              @db.Text
  errorMessage        String?              @map("error_message") @db.Text
  code                String?              @db.Text
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  closedAt            DateTime?            @map("closed_at") @db.Timestamptz(6)
  hiddenAt            DateTime?            @map("hidden_at") @db.Timestamptz(6)
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  author              User                 @relation("QuestionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  assignedMentor      User?                @relation("QuestionAssignedMentor", fields: [assignedMentorId], references: [id], onDelete: Restrict)
  relatedAssignment   Assignment?          @relation(fields: [relatedAssignmentId], references: [id], onDelete: Restrict)
  answers             QuestionAnswer[]
  attachments         QuestionAttachment[]

  @@index([organizationId, boardType, status, createdAt])
  @@index([authorId, createdAt])
  @@index([assignedMentorId, status, createdAt])
  @@map("questions")
}

model QuestionAnswer {
  id          String               @id @default(uuid()) @db.Uuid
  questionId  String               @map("question_id") @db.Uuid
  authorId    String               @map("author_id") @db.Uuid
  parentId    String?              @map("parent_id") @db.Uuid
  content     String               @db.Text
  code        String?              @db.Text
  isAccepted  Boolean              @default(false) @map("is_accepted")
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  editedAt    DateTime?            @map("edited_at") @db.Timestamptz(6)
  hiddenAt    DateTime?            @map("hidden_at") @db.Timestamptz(6)
  question    Question             @relation(fields: [questionId], references: [id], onDelete: Restrict)
  author      User                 @relation(fields: [authorId], references: [id], onDelete: Restrict)
  parent      QuestionAnswer?      @relation("QuestionAnswerReplies", fields: [parentId], references: [id], onDelete: Restrict)
  replies     QuestionAnswer[]     @relation("QuestionAnswerReplies")
  attachments QuestionAttachment[]

  @@index([questionId, createdAt])
  @@index([authorId, createdAt])
  @@map("question_answers")
}

model QuestionAttachment {
  id               String          @id @default(uuid()) @db.Uuid
  questionId       String?         @map("question_id") @db.Uuid
  answerId         String?         @map("answer_id") @db.Uuid
  storagePath      String          @unique @map("storage_path") @db.VarChar(500)
  originalFilename String          @map("original_filename") @db.VarChar(255)
  mimeType         String          @map("mime_type") @db.VarChar(100)
  sizeBytes        Int             @map("size_bytes")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  question         Question?       @relation(fields: [questionId], references: [id], onDelete: Restrict)
  answer           QuestionAnswer? @relation(fields: [answerId], references: [id], onDelete: Restrict)

  @@index([questionId])
  @@index([answerId])
  @@map("question_attachments")
}
